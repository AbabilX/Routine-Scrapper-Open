# Copy this file to `.env` and fill in locally.
# Never commit `.env`. Never put the real host or paths in Dart, docs, or rules.
#
# No trailing slash on API_BASE_URL. Path values start with `/`.
API_BASE_URL=
API_PATH_ROUTINE_VERSION=
API_PATH_AUTOCOMPLETE=
API_PATH_SCHEDULE=
API_PATH_FREE_ROOMS=
API_PATH_ROOMS_STATIC=
API_PATH_TEACHERS_STATIC=
